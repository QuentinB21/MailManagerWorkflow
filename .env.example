# PostgreSQL local uniquement. Remplacez ces valeurs dans votre fichier .env non versionné.
POSTGRES_DB=mailmanager
POSTGRES_USER=mailmanager
POSTGRES_PASSWORD=admin

# n8n chiffre ses credentials avec cette clé. Générez une valeur aléatoire longue et ne la commitez pas.
N8N_ENCRYPTION_KEY=admin

# Fuseau utilisé par n8n pour les futurs déclenchements planifiés.
GENERIC_TIMEZONE=Europe/Paris

# L'historique contient uniquement un aperçu du sujet et la décision de classement.
# Il est purgé automatiquement au-delà de cette durée.
PROCESSING_LOG_RETENTION_DAYS=90
DATA_RETENTION_CLEANUP_HOURS=24

# Laisser à false. true remplace volontairement le workflow n8n existant par le JSON versionné.
N8N_BOOTSTRAP_FORCE_IMPORT=false

# Keycloak protège l'application et l'API. Remplacez impérativement ces valeurs
# avant toute exposition publique. Le compte local `owner` récupère les données
# créées avant l'ajout de l'authentification. Le profil public `demo` utilise un
# mot de passe non secret et ne peut accéder qu'aux simulations.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_LOCAL_USER_PASSWORD=replace-with-a-long-random-password

# Secret partagé uniquement entre Keycloak et le compte de service n8n.
N8N_API_CLIENT_SECRET=replace-with-a-long-random-password

# OAuth Gmail administré par l’exploitant. Ces valeurs ne sont jamais demandées
# aux utilisateurs et doivent rester uniquement dans le fichier .env non versionné.
# Créez un client OAuth 2.0 de type « Application Web » dans Google Cloud.
# Activez l’API Gmail et déclarez exactement cette URI de redirection :
# http://localhost:8080/api/gmail/oauth/callback
# Ne commitez jamais les vraies valeurs : copiez ce fichier vers .env.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# OAuth Microsoft Outlook / Microsoft Graph, administré par l’exploitant.
# Créez une inscription d’application Web dans Microsoft Entra ID et déclarez :
# http://localhost:8080/api/outlook/oauth/callback
# Types de comptes recommandés : organisations + comptes Microsoft personnels.
# Permissions déléguées : User.Read, Mail.ReadWrite, MailboxSettings.ReadWrite.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common

# Informations publiques obligatoires avant la mise en ligne. Elles sont intégrées
# au frontend pendant sa construction : reconstruisez le service web après modification.
# Ne laissez aucune valeur vide sur une instance accessible au public.
# `identified` pour un éditeur professionnel ou `protected-non-professional`
# pour le régime de l'article 1-1 II de la LCEN (uniquement si l'édition est
# réellement non professionnelle et si l'hébergeur détient l'identité complète).
LEGAL_PUBLISHER_DISCLOSURE_MODE=identified
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_FORM=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_EMAIL=
LEGAL_PUBLISHER_PHONE=
LEGAL_REGISTRATION_NUMBER=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
LEGAL_HOSTING_LOCATION=
LEGAL_PRIVACY_EMAIL=
