FROM node:24-alpine AS build
WORKDIR /app
RUN npm install --global pnpm@11.16.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG VITE_API_URL=http://localhost:8080
ARG VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/mail-manager/email
ARG VITE_N8N_GMAIL_WEBHOOK_URL=http://localhost:5678/webhook/mail-manager/gmail/sync
ARG VITE_KEYCLOAK_URL=http://localhost:8081
ARG VITE_KEYCLOAK_REALM=mail-manager
ARG VITE_KEYCLOAK_CLIENT_ID=mail-manager-web
ARG VITE_LEGAL_PUBLISHER_DISCLOSURE_MODE=identified
ARG VITE_LEGAL_PUBLISHER_NAME=
ARG VITE_LEGAL_PUBLISHER_FORM=
ARG VITE_LEGAL_PUBLISHER_ADDRESS=
ARG VITE_LEGAL_PUBLISHER_EMAIL=
ARG VITE_LEGAL_PUBLISHER_PHONE=
ARG VITE_LEGAL_REGISTRATION_NUMBER=
ARG VITE_LEGAL_PUBLICATION_DIRECTOR=
ARG VITE_LEGAL_HOST_NAME=
ARG VITE_LEGAL_HOST_ADDRESS=
ARG VITE_LEGAL_HOST_PHONE=
ARG VITE_LEGAL_HOSTING_LOCATION=
ARG VITE_LEGAL_PRIVACY_EMAIL=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_N8N_WEBHOOK_URL=$VITE_N8N_WEBHOOK_URL
ENV VITE_N8N_GMAIL_WEBHOOK_URL=$VITE_N8N_GMAIL_WEBHOOK_URL
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_LEGAL_PUBLISHER_DISCLOSURE_MODE=$VITE_LEGAL_PUBLISHER_DISCLOSURE_MODE
ENV VITE_LEGAL_PUBLISHER_NAME=$VITE_LEGAL_PUBLISHER_NAME
ENV VITE_LEGAL_PUBLISHER_FORM=$VITE_LEGAL_PUBLISHER_FORM
ENV VITE_LEGAL_PUBLISHER_ADDRESS=$VITE_LEGAL_PUBLISHER_ADDRESS
ENV VITE_LEGAL_PUBLISHER_EMAIL=$VITE_LEGAL_PUBLISHER_EMAIL
ENV VITE_LEGAL_PUBLISHER_PHONE=$VITE_LEGAL_PUBLISHER_PHONE
ENV VITE_LEGAL_REGISTRATION_NUMBER=$VITE_LEGAL_REGISTRATION_NUMBER
ENV VITE_LEGAL_PUBLICATION_DIRECTOR=$VITE_LEGAL_PUBLICATION_DIRECTOR
ENV VITE_LEGAL_HOST_NAME=$VITE_LEGAL_HOST_NAME
ENV VITE_LEGAL_HOST_ADDRESS=$VITE_LEGAL_HOST_ADDRESS
ENV VITE_LEGAL_HOST_PHONE=$VITE_LEGAL_HOST_PHONE
ENV VITE_LEGAL_HOSTING_LOCATION=$VITE_LEGAL_HOSTING_LOCATION
ENV VITE_LEGAL_PRIVACY_EMAIL=$VITE_LEGAL_PRIVACY_EMAIL
RUN pnpm build

FROM nginx:1.29-alpine AS final
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
